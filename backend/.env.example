APP_NAME=SmartCampus AI API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Doit correspondre aux valeurs APP_DB_* du .env racine
DATABASE_URL=postgresql+psycopg://smartcampus_app:change_me_app@localhost:5432/smartcampus

# Pour plus tard (SA-36)
# LLM_API_KEY=
SESSION_TTL_MINUTES=120
SESSION_MAX_MESSAGES=50
SESSION_MAX_CONVERSATIONS=3
# Mémoire temporaire des conversations (valeurs par défaut)
MEMOIRE_TTL_MINUTES=60
MEMOIRE_MAX_MESSAGES_STOCKES=100
MEMOIRE_FENETRE_MESSAGES=10
MEMOIRE_MAX_CARACTERES=2000
